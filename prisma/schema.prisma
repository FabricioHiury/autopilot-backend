generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String            @id @default(uuid())
  email                  String            @unique @db.VarChar(255)
  password               String            @db.VarChar(200)
  status                 String            @default("pending")
  profile                String            @default("user")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  name                   String?
  photoUrl               String?           @map("photo_url")
  emailConfirmed         Boolean           @default(false) @map("email_confirmed")
  tokenConfirmationEmail String?           @map("token_confirmation_email")
  tokenExpiresAt         DateTime?         @map("token_expires_at")
  expoPushToken          String?           @map("expo_push_token")
  employee               Employee?
  dealComment            DealComment[]
  DealActivityLog        DealActivityLog[]
  storeOwner             StoreOwner?
  message                Message[]
  notifications          Notification[]
  permission             Permission[]
  repliesTicket          TicketReply[]
  DealSuspension         DealSuspension[]
  ticketHistory          TicketHistory[]
  tickets                SupportTicket[]

  @@map("users")
}

model Store {
  customization            StoreCustomization?
  id                       String              @id @default(uuid())
  storeOwnerId             String              @unique @map("store_owner_id")
  taxId                    String              @unique @map("tax_id")
  companyName              String              @map("company_name")
  registrationMunicipal    String?             @map("registration_municipal")
  registrationState        String?             @map("registration_state")
  regimeTax                String?             @map("regime_tax")
  portalCompany            String?             @map("portal_company")
  activityPrimary          String?             @map("activity_primary")
  descriptionActivity      String?             @map("description_activity")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  photoUrl                 String?             @map("photo_url")
  wppConfigured            Boolean             @default(false) @map("wpp_configured")
  wppInstance              String?             @map("wpp_instance")
  wppApiType               String?             @default("unofficial") @map("wpp_api_type")
  wppOfficialWabaId        String?             @map("wpp_official_waba_id")
  wppOfficialPhoneNumberId String?             @map("wpp_official_phone_number_id")
  wppOfficialAccessToken   String?             @map("wpp_official_access_token")
  wppOfficialVerifyToken   String?             @map("wpp_official_verify_token")
  wppOfficialPhone         String?             @map("wpp_official_phone")
  distributionAutomatic    Boolean             @default(false) @map("distribution_automatic")
  integrationsEnabled      Boolean?            @default(false) @map("integrations_enabled")
  deal                     Deal[]
  dealAssignee             DealAssignee[]
  roles                    Role[]
  chat                     Chat[]
  ChatAssignee             ChatAssignee[]
  customer                 Customer[]
  employee                 Employee[]
  dealsShared              DealShare[]
  storeContact             StoreContact[]
  storeAddress             StoreAddress[]
  storeHistory             StoreHistory[]
  storeOwner               StoreOwner          @relation(fields: [storeOwnerId], references: [id], onDelete: Cascade)
  tags                     Tag[]
  tickets                  SupportTicket[]
  messageTemplates         MessageTemplate[]

  @@map("stores")
}

model Role {
  id        String     @id @default(uuid())
  storeId   String     @map("store_id")
  role      String
  features  String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employees Employee[] @relation("role_employee")

  @@unique([storeId, role])
  @@map("roles")
}

model StoreHistory {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  typeEvent   String   @map("type_event")
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_histories")
}

model StoreOwner {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  status            String   @default("active")
  deviceToken       String?  @map("device_token")
  tokenCustomerMeta String?  @map("token_customer_meta")
  tokenCustomerOlx  String?  @map("token_customer_olx")
  store             Store?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("store_owners")
}

model StoreAddress {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  postalCode String?  @map("postal_code")
  state      String
  city       String
  street     String?
  number     String?
  district   String?
  complement String?
  branch     Boolean
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_addresses")
}

model StoreContact {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String?
  mobile    String?
  phone     String?
  email     String?
  site      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_contacts")
}

model Employee {
  id               String             @id @default(uuid())
  storeId          String             @map("store_id")
  userId           String             @unique @map("user_id")
  photoUrl         String?            @map("photo_url")
  name             String?
  taxId            String?            @unique @map("tax_id")
  status           String             @default("active")
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  phoneAdditional  String?            @map("phone_additional")
  whatsapp         String?
  dealAssignee     DealAssignee[]
  ChatAssignee     ChatAssignee[]
  customerEmployee CustomerEmployee[]
  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealsShared      DealShare[]
  dealTask         DealTask[]
  roles            Role[]             @relation("role_employee")

  @@unique([storeId, taxId])
  @@map("employees")
}

model Customer {
  id                      String                        @id @default(uuid())
  storeId                 String                        @map("store_id")
  name                    String
  typePerson              String                        @map("type_person")
  taxId                   String                        @map("tax_id")
  identityNumber          String?                       @map("identity_number")
  foreigner               Boolean
  gender                  String
  birthDate               DateTime                      @map("birth_date")
  notes                   String?
  phone                   String
  whatsapp                String
  email                   String
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  status                  String                        @default("active")
  version                 Int
  avatarUrl               String?                       @map("avatar_url")
  attachment              CustomerAttachment[]
  deal                    Deal[]
  chat                    Chat[]
  store                   Store                         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerEmployee        CustomerEmployee[]
  customerAddress         CustomerAddress?
  historyDataRegistration CustomerRegistrationHistory[]

  @@unique([taxId, storeId])
  @@unique([email, storeId])
  @@map("customers")
}

model CustomerAttachment {
  id         String    @id @default(uuid())
  fileId     String    @unique @map("file_id")
  customerId String    @map("customer_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  file       UuidFile  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_attachments")
}

model CustomerRegistrationHistory {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  version      Int
  update       String?
  createdAt    DateTime @default(now()) @map("created_at")
  idUserEditor String?  @map("id_user_editor")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_registration_histories")
}

model CustomerEmployee {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  employeeId String   @map("employee_id")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("customer_employees")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String   @unique @map("customer_id")
  postalCode String   @map("postal_code")
  state      String
  city       String
  address    String
  district   String
  number     String
  complement String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Deal {
  id                  String             @id @default(uuid())
  customerId          String?            @map("customer_id")
  temporaryCustomerId String?            @map("temporary_customer_id")
  dealOrigin          String             @map("deal_origin")
  temperature         String
  status              String
  descriptionDeal     String?            @map("description_deal")
  note                String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  storeId             String?            @map("store_id")
  title               String?
  dealMode            String?            @map("deal_mode")
  dealManual          Boolean?           @default(false) @map("deal_manual")
  isArchived          Boolean            @default(false) @map("is_archived")
  attachments         DealAttachment[]
  customer            Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  temporaryCustomer   TemporaryCustomer? @relation(fields: [temporaryCustomerId], references: [id], onDelete: Cascade)
  store               Store?             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dealAssignee        DealAssignee[]
  dealTags            DealTag[]
  chat                Chat[]
  dealComment         DealComment[]
  shares              DealShare[]
  dealActivityLogs    DealActivityLog[]
  DealSuspension      DealSuspension[]
  dealTask            DealTask[]
  dealVisit           DealVisit[]

  @@index([status])
  @@index([updatedAt])
  @@index([storeId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([storeId, dealMode, createdAt])
  @@index([dealOrigin])
  @@index([temperature])
  @@map("deals")
}

model DealAttachment {
  id           String    @id @default(uuid())
  dealId       String    @map("deal_id")
  fileId       String    @unique @map("file_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  nameOriginal String?   @map("name_original")
  file         File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("deal_attachments")
}

model TemporaryCustomer {
  id                String   @id @default(uuid())
  name              String?
  email             String?
  whatsapp          String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  externalContactId String   @map("external_contact_id")
  channel           String
  avatar            String?
  storeId           String?  @map("store_id")
  deal              Deal[]
  chat              Chat[]

  @@map("temporary_customers")
}

model DealShare {
  id         String   @id @default(uuid())
  dealId     String   @map("deal_id")
  employeeId String   @map("employee_id")
  storeId    String   @map("store_id")
  sharedBy   String?  @map("shared_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("deal_shares")
}

model DealAssignee {
  id         String   @id @default(uuid())
  dealId     String   @map("deal_id")
  employeeId String   @map("employee_id")
  storeId    String?  @map("store_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  store      Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([employeeId, dealId])
  @@map("deal_assignees")
}

model DealTask {
  id         String   @id @default(uuid())
  dealId     String   @map("deal_id")
  assigneeId String   @map("assignee_id")
  name       String
  data       DateTime
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  completed  Boolean  @default(false)
  hourEnd    String?  @map("hour_end")
  hourStart  String?  @map("hour_start")
  notes      String?
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [assigneeId], references: [id], onDelete: Cascade)

  @@map("deal_tasks")
}

model DealVisit {
  id        String   @id @default(uuid())
  dealId    String   @map("deal_id")
  notes     String?
  type      String
  data      DateTime
  hourStart String   @map("hour_start")
  hourEnd   String?  @map("hour_end")
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, completed])
  @@map("deal_visits")
}

model DealComment {
  id            String   @id @default(uuid())
  dealId        String   @map("deal_id")
  comment       String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  userId        String   @map("user_id")
  lostReason    String?  @map("lost_reason")
  subLostReason String?  @map("sub_lost_reason")
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dealId, lostReason])
  @@map("deal_comments")
}

model DealSuspension {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  dealId      String?  @map("deal_id")
  Deal        Deal?    @relation(fields: [dealId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("deal_suspensions")
}

model DealActivityLog {
  id           String   @id @default(uuid())
  dealId       String   @map("deal_id")
  message      String
  createdAt    DateTime @default(now()) @map("created_at")
  dataPrevious Json?    @map("data_previous")
  dataNew      Json?    @map("data_new")
  userId       String?  @map("user_id")
  typeEvent    String   @map("type_event")
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id])

  @@index([dealId, typeEvent])
  @@index([dealId, createdAt])
  @@map("deal_activity_logs")
}

model File {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  entityId          String             @map("entity_id")
  entity            String             @db.VarChar(100)
  name              String
  type              String
  url               String
  expiresAt         DateTime           @map("expires_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  editedAt          DateTime?          @updatedAt @map("edited_at")
  version           Int                @default(0)
  size              Int                @default(0)
  dealAttachment    DealAttachment?
  chatAttachment    ChatAttachment?
  supportAttachment SupportAttachment?
  publicImage       PublicImage?

  @@map("files")
}

model UuidFile {
  id                 String              @id @default(uuid())
  name               String
  type               String
  url                String
  expiresAt          DateTime            @map("expires_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  editedAt           DateTime?           @updatedAt @map("edited_at")
  version            Int                 @default(0)
  customerAttachment CustomerAttachment?

  @@map("uuid_files")
}

model Permission {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  feature   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String
  message     String
  status      String
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  idReference String?  @map("id_reference")
  user        User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Chat {
  aiInsight             Json?              @map("ai_insight")
  aiAnalyzedAt          DateTime?          @map("ai_analyzed_at")
  id                    String             @id @default(uuid())
  storeId               String             @map("store_id")
  customerId            String?            @map("customer_id")
  temporaryCustomerId   String?            @map("temporary_customer_id")
  dealId                String?            @map("deal_id")
  externalRecipientId   String             @map("external_recipient_id")
  channel               String
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  externalAdId          String?            @map("external_ad_id")
  archived              Boolean            @default(false)
  lastMessageCustomerAt DateTime?          @map("last_message_customer_at")
  chatAttachment        ChatAttachment[]
  deal                  Deal?              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  customer              Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  temporaryCustomer     TemporaryCustomer? @relation(fields: [temporaryCustomerId], references: [id], onDelete: Cascade)
  store                 Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  chatAssignee          ChatAssignee[]
  message               Message[]

  @@unique([customerId, storeId, channel])
  @@unique([temporaryCustomerId, storeId, channel])
  @@index([storeId, channel, externalRecipientId])
  @@index([storeId, channel, externalRecipientId, dealId])
  @@index([createdAt])
  @@map("chats")
}

model ChatAssignee {
  id         String   @id @default(uuid())
  chatId     String   @map("chat_id")
  employeeId String   @map("employee_id")
  storeId    String?  @map("store_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  store      Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([chatId, employeeId])
  @@map("chat_assignees")
}

model ChatAttachment {
  id             String    @id @default(uuid())
  chatId         String    @map("chat_id")
  fileId         String    @unique @map("file_id")
  attachmentType String    @map("attachment_type")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")
  file           File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  chat           Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_attachments")
}

model Message {
  deliveryStatus      String         @default("PENDING") @map("delivery_status")
  id                  String         @id @default(uuid())
  userId              String?        @map("user_id")
  chatId              String         @map("chat_id")
  externalRecipientId String?        @map("external_recipient_id")
  externalMessageId   String?        @map("external_message_id")
  quotedMessageId     String?        @map("quoted_message_id")
  attachmentUrl       String?        @map("attachment_url")
  attachmentType      String?        @map("attachment_type")
  type                String?
  reaction            String?
  content             String?
  channel             String
  createdAt           DateTime       @default(now()) @map("created_at")
  sender              String
  isRead              Boolean        @default(true) @map("is_read")
  originInstagram     String?        @map("origin_instagram")
  metadata            Json?
  user                User?          @relation(fields: [userId], references: [id])
  chat                Chat           @relation(fields: [chatId], references: [id])
  person              MessagePerson?

  @@map("messages")
}

model MessageTemplate {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  title     String   @db.VarChar(100)
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("message_templates")
}

model MessagePerson {
  id        String  @id @default(uuid())
  messageId String  @unique @map("message_id")
  name      String?
  avatar    String?
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_persons")
}

model Faq {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  category  String
  content   String
  status    String   @default("draft")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  summary   String?
  views     Int      @default(0)
  tags      FaqTag[] @relation("faq_tags")

  @@map("faqs")
}

model FaqTag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  faqs      Faq[]    @relation("faq_tags")

  @@map("faq_tags")
}

model SupportTicket {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  storeId   String?             @map("store_id")
  title     String
  subject   String
  message   String
  priority  String              @default("normal")
  status    String              @default("open")
  type      String?
  category  String?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  files     SupportAttachment[]
  replies   TicketReply[]
  history   TicketHistory[]
  store     Store?              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model TicketHistory {
  id        String        @id @default(uuid())
  event     String
  action    String
  idTicket  String        @map("id_ticket")
  userId    String        @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  ticket    SupportTicket @relation(fields: [idTicket], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_histories")
}

model TicketReply {
  id        String              @id @default(uuid())
  idTicket  String              @map("id_ticket")
  userId    String              @map("user_id")
  reply     String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  files     SupportAttachment[]
  ticket    SupportTicket       @relation(fields: [idTicket], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}

model SupportAttachment {
  id           String        @id @default(uuid())
  idReply      String?       @map("id_reply")
  fileId       String?       @unique @map("file_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime?     @updatedAt @map("updated_at")
  idTicket     String        @map("id_ticket")
  nameOriginal String?       @map("name_original")
  file         File?         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  reply        TicketReply?  @relation(fields: [idReply], references: [id], onDelete: Cascade)
  ticket       SupportTicket @relation(fields: [idTicket], references: [id], onDelete: Cascade)

  @@map("support_attachments")
}

model PublicImage {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  fileId    String?   @unique @map("file_id")
  file      File?     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("public_images")
}

model Tag {
  id          String    @id @default(uuid())
  name        String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  color       String?
  description String?
  storeId     String    @map("store_id")
  dealTags    DealTag[]
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([name, storeId])
  @@map("tags")
}

model DealTag {
  id        String   @id @default(uuid())
  dealId    String   @map("deal_id")
  idTag     String   @map("id_tag")
  createdAt DateTime @default(now()) @map("created_at")
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [idTag], references: [id], onDelete: Cascade)

  @@unique([dealId, idTag])
  @@map("deal_tags")
}

model StoreCustomization {
  id                 String   @id @default(uuid())
  storeId            String   @unique @map("store_id")
  slug               String   @unique
  displayName        String   @map("display_name")
  logoLightUrl       String?  @map("logo_light_url")
  logoDarkUrl        String?  @map("logo_dark_url")
  faviconUrl         String?  @map("favicon_url")
  loginBackgroundUrl String?  @map("login_background_url")
  primaryColor       String   @default("#1E40AF") @map("primary_color")
  secondaryColor     String   @default("#F3F4F6") @map("secondary_color")
  accentColor        String   @default("#3B82F6") @map("accent_color")
  openingTime        String   @default("08:00") @map("opening_time")
  closingTime        String   @default("18:00") @map("closing_time")
  workingDays        Json?    @map("working_days")
  commissionRules    Json?    @map("commission_rules")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_customizations")
}

model InboundEvent {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  eventId     String   @map("event_id")
  kind        String
  payload     Json
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([storeId, eventId, kind])
  @@index([status, availableAt])
  @@map("inbound_events")
}
