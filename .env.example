# Server Configuration
PORT=3003
BASE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/autopilot?schema=public&conexion_limit=100

# API Configuration
API_BASE_URL=http://localhost:3005
API_KEY=your-api-key-here

# JWT Secrets
JWT_SECRET=your-jwt-secret-here
JWT_RESET_SECRET=your-jwt-reset-secret-here

# Email Configuration (SMTP)
DEFAULT_EMAIL_FROM=no-reply@example.com
SMTP_EMAIL=your-smtp-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_PORT=465
SMTP_SERVER=smtp.example.com

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_BUCKET_NAME=your-bucket-name
AWS_REGION=sa-east-1
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=autopilot
REDIS_PASSWORD=your-redis-password

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Novu Configuration
NOVU_API_KEY=your-novu-api-key
