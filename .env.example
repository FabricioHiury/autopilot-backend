# Server Configuration
PORT=3003
BASE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/autopilot?schema=public&connection_limit=100

# API Configuration
MICROSERVICE_URL=http://localhost:3005
MICROSERVICE_TOKEN=replace-with-a-shared-secret
# Optional Socket.io namespace exposed by the microservice; leave empty for webhook-only ingress.
MICROSERVICE_WS_URL=

# JWT Secrets
JWT_SECRET=your-jwt-secret-here
JWT_RESET_SECRET=your-jwt-reset-secret-here

# Email Configuration (SMTP)
DEFAULT_EMAIL_FROM=no-reply@example.com
SMTP_EMAIL=your-smtp-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_PORT=465
SMTP_SERVER=smtp.example.com

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_BUCKET_NAME=your-bucket-name
AWS_REGION=sa-east-1
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=autopilot
REDIS_PASSWORD=your-redis-password

# Novu Configuration
NOVU_API_KEY=your-novu-api-key

# Chat AI: full URL of a chat-completions-compatible LLM endpoint supporting json_schema.
# All three values are required to enable analysis; disabled when omitted.
# Local Ollama: URL=http://127.0.0.1:11434/v1/chat/completions,
# API_KEY=ollama, MODEL=gemma3:1b (see docker/local/README.md).
CHAT_AI_URL=
CHAT_AI_API_KEY=
CHAT_AI_MODEL=

# File storage (required by the existing Firebase storage module)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
